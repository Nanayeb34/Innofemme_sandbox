# AI assistant (OpenAI). Leave unset to run without the assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Offline back-up: point at a local OpenAI-compatible server instead, e.g. Ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen3:14b
AI_DAILY_TOKEN_BUDGET=400000

# Where worlds, snapshots and team keys are stored (default: ~/.momo-sandbox)
SANDBOX_DATA_DIR=
# Used only when teams.json is first created
SANDBOX_TEAMS=10
ORGANISER_KEY=
SANDBOX_SEED=2026
# Public URL printed on QR cards (otherwise taken from the request)
PUBLIC_URL=
