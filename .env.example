# Where worlds, save points and team keys are stored (default: ~/.momo-sandbox)
SANDBOX_DATA_DIR=
# Used only when teams.json is first created
SANDBOX_TEAMS=10
ORGANISER_KEY=
# Public URL printed on QR cards (otherwise taken from the request)
PUBLIC_URL=
# Set to "block" on a server every team shares (the Docker image does this): addresses teams type in for their
# plug-in APIs, USSD applications and callbacks must then be out on the internet, not this machine or its private
# network. Leave empty on your own machine, so an API under development on localhost can be plugged in.
SANDBOX_PRIVATE_ADDRESSES=

# Voice calls between phones. Leave empty and calls connect directly, which works only where the
# Wi-Fi lets phones reach each other. Set both to relay call audio through Cloudflare Realtime TURN
# (Cloudflare dashboard > Realtime > TURN > create a key).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# The assistant: a small team of AI agents that works in a team's world on the team's instructions.
# It is switched on by giving the server a key for ONE of these services. With neither, the assistant
# is simply not shown and everything else works as usual.
#   Claude:  ANTHROPIC_API_KEY   (default model claude-opus-5-5)
#   OpenAI:  OPENAI_API_KEY      (default model gpt-6.2-sol)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Only needed when both keys are set (anthropic or openai), or to name another model.
# ASSISTANT_PROVIDER=demo shows the assistant without any key: it does real work with real tools, but its words are scripted.
ASSISTANT_PROVIDER=
ASSISTANT_MODEL=
# How many times a day each team's assistant may call the model (default 600). A typical instruction takes 3 to 15.
ASSISTANT_DAILY_CALLS=
