# Where worlds, save points and team keys are stored (default: ~/.momo-sandbox)
SANDBOX_DATA_DIR=
# Used only when teams.json is first created
SANDBOX_TEAMS=10
ORGANISER_KEY=
# Public URL printed on QR cards (otherwise taken from the request)
PUBLIC_URL=

# Voice calls between phones. Leave empty and calls connect directly, which works only where the
# Wi-Fi lets phones reach each other. Set both to relay call audio through Cloudflare Realtime TURN
# (Cloudflare dashboard > Realtime > TURN > create a key).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
